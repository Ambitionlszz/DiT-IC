+def interface_gradient_norm(loss, latent, scale=1.):
+    """Scale small gradients, and keep backward outside forward's autocast."""
+    # This probe can be called inside the forward autocast context. SANA's
+    # attention backward requires its saved FP32 contractions to stay FP32;
+    # autocasting backward makes both RD and SF probes nonfinite on V100.
+    with torch.autocast(device_type=latent.device.type, enabled=False):
+        gradient = torch.autograd.grad(loss*scale, latent, retain_graph=True)[0]
+        return gradient.float().div(scale).norm()
+
