+++ b/models/bt_self_flow/checkpoint.py
@@ -181,16 +181,24 @@ class BestCheckpoint:
 
 
 @contextmanager
-def evaluation_state(model, state=None):
+def evaluation_state(model, state=None, *, deployment=False):
     training = model.training
     saved = clone_state(model.export_state()) if state is not None else None
+    router_strength = model.codec.router_strength.detach().clone() if deployment else None
     try:
         if state is not None:
             model.load_bt_state(state)
         model.eval()
+        if deployment:
+            # Router strength is a training curriculum, not transmitted packet
+            # metadata. Evaluate the deployable model on both the hard forward
+            # and entropy paths; never weaken the codec's encode/decode guard.
+            model.codec.router_strength.fill_(1.)
         model.codec.update(force=True)
         yield
     finally:
         if saved is not None:
             model.load_bt_state(saved)
+        elif router_strength is not None:
+            model.codec.router_strength.copy_(router_strength)
         model.train(training)
